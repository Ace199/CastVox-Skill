{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Host Bridge application protocol 1.0",
  "$ref": "#/$defs/result",
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "task_id",
        "status",
        "revision",
        "data",
        "error"
      ],
      "properties": {
        "protocol_version": {
          "const": "1.0"
        },
        "application": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "task_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "status": {
          "enum": [
            "ready",
            "waiting",
            "completed",
            "cancelled",
            "failed"
          ]
        },
        "revision": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "data": {
          "type": "object"
        },
        "error": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/error"
            }
          ]
        },
        "handle": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "resource": {
          "type": "object"
        },
        "wait_tool": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "arguments"
          ],
          "properties": {
            "name": {
              "const": "host_bridge_wait"
            },
            "arguments": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "handle",
                "timeout",
                "protocol_version"
              ],
              "properties": {
                "handle": {
                  "type": "string",
                  "minLength": 1
                },
                "timeout": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 55
                },
                "protocol_version": {
                  "const": "1.0"
                }
              }
            }
          }
        },
        "wait_cancelled": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            }
          },
          "then": {
            "properties": {
              "error": {
                "$ref": "#/$defs/error"
              }
            }
          },
          "else": {
            "properties": {
              "error": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "waiting",
                  "completed",
                  "cancelled"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "task_id": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      ]
    },
    "submission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "task_id",
        "submission_id",
        "expected_revision",
        "action",
        "data"
      ],
      "properties": {
        "protocol_version": {
          "const": "1.0"
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "submission_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "action": {
          "enum": [
            "complete",
            "cancel"
          ]
        },
        "data": {
          "type": "object"
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      }
    },
    "start": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "application",
        "operation",
        "request_id",
        "payload"
      ],
      "properties": {
        "protocol_version": {
          "const": "1.0"
        },
        "application": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "payload": {
          "type": "object"
        }
      }
    }
  }
}
